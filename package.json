{
	"name": "@oscarpalmer/mora",
	"version": "0.38.0",
	"description": "Signals and stuff…",
	"keywords": [
		"reactive",
		"signal",
		"signals"
	],
	"license": "MIT",
	"author": {
		"name": "Oscar Palmér",
		"url": "https://oscarpalmer.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarpalmer/mora.git"
	},
	"files": [
		"dist",
		"src",
		"types"
	],
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "vpx vp run tsdown:build && vpx vp pack",
		"tsdown:build": "vpx tsdown -c ./tsdown.config.ts",
		"tsdown:watch": "vpx tsdown -c ./tsdown.config.ts --watch",
		"test": "npx vp test run --coverage",
		"test:leak": "vpx vp test run --detect-async-leaks --coverage"
	},
	"dependencies": {
		"@oscarpalmer/atoms": "^0.205"
	},
	"devDependencies": {
		"@types/node": "^26.6",
		"@vitest/coverage-istanbul": "5.0.1",
		"jsdom": "^30.1",
		"tsdown": "^0.23",
		"typescript": "^7",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vite-plus": "1.0.0",
		"vitest": "5.0.1"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vitest": "5.0.1"
	},
	"packageManager": "npm@11.19.0"
}
